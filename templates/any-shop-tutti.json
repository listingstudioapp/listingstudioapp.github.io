{
 "format": "listing-studio-template",
 "version": 1,
 "description": "tutti.ch in German: title with sizes (60 characters), description, price in CHF, condition, a link to the product page and photos read from any shop that publishes its product data. Set the category in the template, or choose it on the form and press Fill form again.",
 "template": {
  "name": "tutti.ch (any shop)",
  "url": "https://www.tutti.ch/de/listings/new",
  "path": "/*",
  "bindings": [],
  "connectorId": "tutti",
  "shipping": "",
  "ready": true,
  "inputs": {
   "title": {"mode": "template", "value": "{{title|fit:60}}{{#sizes}}, Gr. {{sizes|join:/|fit:60}}{{/sizes}}"},
   "condition": {"mode": "field", "value": "condition"},
   "price": {"mode": "field", "value": "price"},
   "description": {"mode": "template", "value": "{{title}}{{#brand}}\nMarke: {{brand}}{{/brand}}{{#sizes}}\nGrössen: {{sizes}}{{/sizes}}{{#condition=new}}\nZustand: neu{{/condition}}{{#condition=used}}\nZustand: gebraucht{{/condition}}{{#description}}\n\n{{description|fit:4000|sentences}}{{/description}}"},
   "link": {"mode": "template", "value": "{{url}}"},
   "photos": {"mode": "field", "value": "photos"}
  }
 },
 "source": {
  "name": "Any shop (automatic)",
  "anyShop": true,
  "path": "/*",
  "fields": [
   {"id": "f-title", "name": "title", "type": "auto", "key": "title"},
   {"id": "f-price", "name": "price", "type": "auto", "key": "price"},
   {"id": "f-description", "name": "description", "type": "auto", "key": "description", "optional": true},
   {"id": "f-brand", "name": "brand", "type": "auto", "key": "brand", "optional": true},
   {"id": "f-sizes", "name": "sizes", "type": "auto", "key": "sizes", "optional": true},
   {"id": "f-condition", "name": "condition", "type": "auto", "key": "condition", "optional": true},
   {"id": "f-photos", "name": "photos", "type": "auto", "key": "photos"}
  ]
 }
}
