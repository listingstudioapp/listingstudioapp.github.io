{
 "format": "listing-studio-template",
 "version": 1,
 "description": "leboncoin.fr in French: title with sizes, description, price, brand, condition and photos read from any shop that publishes its product data. Category: one of leboncoin's suggestions after the title; set it in the template, or choose it on the form and press Fill form again.",
 "template": {
  "name": "leboncoin (any shop)",
  "url": "https://www.leboncoin.fr/deposer-une-annonce",
  "path": "/*",
  "bindings": [],
  "connectorId": "leboncoin",
  "shipping": "",
  "ready": true,
  "inputs": {
   "title": {"mode": "template", "value": "{{title|fit:100}}{{#sizes}}, taille {{sizes|join:/|fit:100}}{{/sizes}}"},
   "photos": {"mode": "field", "value": "photos"},
   "brand": {"mode": "field", "value": "brand"},
   "condition": {"mode": "field", "value": "condition"},
   "description": {"mode": "template", "value": "{{title}}{{#brand}}\nMarque : {{brand}}{{/brand}}{{#sizes}}\nTailles : {{sizes}}{{/sizes}}{{#condition=new}}\nÉtat : neuf{{/condition}}{{#condition=used}}\nÉtat : occasion{{/condition}}{{#description}}\n\n{{description|fit:4000|sentences}}{{/description}}"},
   "price": {"mode": "field", "value": "price"}
  }
 },
 "source": {
  "name": "Any shop (automatic)",
  "anyShop": true,
  "path": "/*",
  "fields": [
   {"id": "f-title", "name": "title", "type": "auto", "key": "title"},
   {"id": "f-price", "name": "price", "type": "auto", "key": "price"},
   {"id": "f-description", "name": "description", "type": "auto", "key": "description", "optional": true},
   {"id": "f-brand", "name": "brand", "type": "auto", "key": "brand", "optional": true},
   {"id": "f-sizes", "name": "sizes", "type": "auto", "key": "sizes", "optional": true},
   {"id": "f-condition", "name": "condition", "type": "auto", "key": "condition", "optional": true},
   {"id": "f-photos", "name": "photos", "type": "auto", "key": "photos"}
  ]
 }
}
