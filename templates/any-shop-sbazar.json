{
 "format": "listing-studio-template",
 "version": 1,
 "description": "Sbazar.cz in Czech: title with sizes (50 characters), description (2000 characters), price and photos read from any shop that publishes its product data. Set the category in the template, or choose it on the form and press Fill form again.",
 "template": {
  "name": "Sbazar (any shop)",
  "url": "https://www.sbazar.cz/nova-nabidka",
  "path": "/*",
  "bindings": [],
  "connectorId": "sbazar",
  "shipping": "",
  "ready": true,
  "inputs": {
   "title": {"mode": "template", "value": "{{title|fit:50}}{{#sizes}}, vel. {{sizes|join:/|fit:50}}{{/sizes}}"},
   "price": {"mode": "field", "value": "price"},
   "description": {"mode": "template", "value": "{{title}}{{#brand}}\nZnačka: {{brand}}{{/brand}}{{#sizes}}\nVelikosti: {{sizes}}{{/sizes}}{{#condition=new}}\nStav: nové{{/condition}}{{#condition=used}}\nStav: použité{{/condition}}{{#description}}\n\n{{description|fit:2000|sentences}}{{/description}}"},
   "photos": {"mode": "field", "value": "photos"}
  }
 },
 "source": {
  "name": "Any shop (automatic)",
  "anyShop": true,
  "path": "/*",
  "fields": [
   {"id": "f-title", "name": "title", "type": "auto", "key": "title"},
   {"id": "f-price", "name": "price", "type": "auto", "key": "price"},
   {"id": "f-description", "name": "description", "type": "auto", "key": "description", "optional": true},
   {"id": "f-brand", "name": "brand", "type": "auto", "key": "brand", "optional": true},
   {"id": "f-sizes", "name": "sizes", "type": "auto", "key": "sizes", "optional": true},
   {"id": "f-condition", "name": "condition", "type": "auto", "key": "condition", "optional": true},
   {"id": "f-photos", "name": "photos", "type": "auto", "key": "photos"}
  ]
 }
}
