{
  "format": 1,
  "id": "willhaben",
  "name": "willhaben.at",
  "version": "2026.11.18",
  "sites": {
    "willhaben": {"name": "willhaben.at", "ads": ["^/iad/kaufen-und-verkaufen/d/[^/]+-[0-9]+/?$"], "origins": ["https://www.willhaben.at", "https://willhaben.at"], "start": "https://www.willhaben.at/iad/anzeigenaufgabe/marktplatz?adTypeId=67&productId=67"}
  },
  "inputs": {
    "title": {"label": "Title (Titel)", "required": true},
    "category": {"label": "Category", "hint": "Path as in the category window, e.g. Sport / Sportgeräte > Wintersport > Schifahren > Schi.", "required": true},
    "condition": {"label": "Condition (Zustand)", "hint": "new, like new, used, defect (Neu / Neuwertig / Gebraucht / Defekt)."},
    "length": {"label": "Ski length (Länge)", "hint": "In cm, e.g. 172: the matching range (170 - 179 cm) is chosen. Only for skis."},
    "price": {"label": "Price (EUR)", "hint": "0 or free: zu verschenken.", "required": true},
    "description": {"label": "Description (Beschreibung)", "required": true},
    "postcode": {"label": "PLZ", "hint": "Needed if your account has none; the town is filled in by willhaben."},
    "photos": {"label": "Photos"},
    "delivery": {"label": "Delivery", "hint": "pickup (Selbstabholung), shipping (Versand) or both. Empty: left as it is."},
    "payLivery": {"label": "willhaben PayLivery", "hint": "yes or no: online payment and shipping through willhaben. Empty: left as it is."},
    "packageSize": {"label": "Package size", "hint": "S (bis 3 kg), M (bis 10 kg) or L (bis 31,5 kg)."},
    "oversize": {"label": "Oversize (Sperrgut)", "hint": "yes for long or bulky items, e.g. skis."},
    "carrier": {"label": "Carrier", "hint": "Post, Hermes or DPD."}
  },
  "never": ["Veröffentlichen", "Anzeige veröffentlichen", "Speichern", "Bezahlen", "Kostenpflichtig bestellen", "Jetzt kaufen", "Löschen", "Erweiterte Haftung"],
  "tables": {
    "condition": {"new": "Neu", "like new": "Neuwertig", "used": "Gebraucht", "good": "Gebraucht", "ok": "Gebraucht", "defect": "Defekt", "defective": "Defekt"},
    "pickup": {"pickup": true, "both": true, "shipping": false},
    "shipping": {"shipping": true, "both": true, "pickup": false},
    "yesNo": {"yes": true, "ja": true, "true": true, "no": false, "nein": false, "false": false},
    "packageSize": {"s": "Paket bis 3 kg", "m": "Paket bis 10 kg", "l": "Paket bis 31,5 kg"}
  },
  "fields": {
    "title": {"title": "Title", "widget": "text", "locate": {"labels": ["Titel"], "names": ["heading"]}, "value": {"$input": "title"}},
    "category": {
      "title": "Category", "widget": "dialog", "path": true,
      "locate": {"trigger": ["Kategorie selbst wählen", "Andere Kategorie wählen"]},
      "value": {"$input": "category"},
      "cancel": ["Schließen", "Abbrechen"]
    },
    "length": {
      "title": "Länge", "widget": "dialog", "optional": true, "if": {"input": "length"},
      "locate": {"near": ["Länge"]},
      "match": {"rangeCovers": {"$input": "length"}}
    },
    "condition": {
      "title": "Zustand", "widget": "radio", "optional": true, "if": {"input": "condition"},
      "locate": {"group": ["Zustand"]},
      "value": {"$lookup": "condition", "table": "condition", "default": {"$input": "condition"}}
    },
    "free": {
      "title": "zu verschenken", "widget": "toggle", "optional": true,
      "if": {"input": "price", "in": ["0", "free", "gratis"]},
      "locate": {"css": "#price-toggle"}, "value": true
    },
    "paid": {
      "title": "zu verschenken off", "widget": "toggle", "optional": true,
      "if": {"not": {"input": "price", "in": ["0", "free", "gratis"]}},
      "locate": {"css": "#price-toggle"}, "value": false
    },
    "price": {
      "title": "Price", "widget": "money", "format": {"fraction": "auto", "decimal": ","},
      "if": {"not": {"input": "price", "in": ["0", "free", "gratis"]}},
      "locate": {"labels": ["Verkaufspreis"], "names": ["price"]}, "value": {"$input": "price"}
    },
    "description": {"title": "Description", "widget": "richtext", "locate": {"labels": ["Beschreibung"]}, "value": {"$input": "description"}},
    "postcode": {"title": "PLZ", "widget": "text", "optional": true, "if": {"input": "postcode"}, "locate": {"labels": ["PLZ"], "names": ["postcode"]}, "value": {"$input": "postcode"}},
    "photos": {"title": "Photos", "widget": "upload", "optional": true, "locate": {"fileInput": true}, "value": {"$input": "photos"}},
    "pickup": {
      "title": "Selbstabholung", "widget": "toggle", "optional": true, "if": {"input": "delivery", "in": ["pickup", "shipping", "both"]},
      "locate": {"css": "input[name=selfPickUp]"}, "value": {"$lookup": "delivery", "table": "pickup"}
    },
    "shipping": {
      "title": "Versand", "widget": "toggle", "optional": true, "if": {"input": "delivery", "in": ["pickup", "shipping", "both"]},
      "locate": {"css": "input[name=delivery]"}, "value": {"$lookup": "delivery", "table": "shipping"}
    },
    "payLivery": {
      "title": "PayLivery", "widget": "toggle", "optional": true, "if": {"input": "payLivery", "in": ["yes", "ja", "true", "no", "nein", "false"]},
      "locate": {"css": "input[name=payliveryDelivery]"}, "value": {"$lookup": "payLivery", "table": "yesNo"}
    },
    "packageSize": {
      "title": "Package size", "widget": "radio", "optional": true, "if": {"input": "packageSize"},
      "locate": {"anywhere": true},
      "value": {"$lookup": "packageSize", "table": "packageSize", "default": {"$input": "packageSize"}}
    },
    "oversize": {
      "title": "Sperrgut", "widget": "toggle", "optional": true, "if": {"input": "oversize", "in": ["yes", "ja", "true", "no", "nein", "false"]},
      "locate": {"css": "input[name=hasOverSize]"}, "value": {"$lookup": "oversize", "table": "yesNo"}
    },
    "carrier": {
      "title": "Carrier", "widget": "radio", "optional": true, "if": {"input": "carrier"},
      "locate": {"anywhere": true}, "match": {"startsWith": {"$input": "carrier"}}
    }
  },
  "steps": [
    {
      "id": "details",
      "when": {"field": "title"},
      "do": [
        {"fill": ["title", "category"]},
        {"fill": ["length", "condition", "free", "paid", "price", "description", "postcode", "photos"]},
        {"advance": "Weiter", "to": "delivery"}
      ]
    },
    {
      "id": "delivery",
      "when": {"field": "pickup"},
      "do": [
        {"dismiss": [{"title": "willhaben-PayLivery", "button": "Überspringen", "timeout": 2500}]},
        {"fill": ["pickup", "shipping", "payLivery", "packageSize", "oversize", "carrier"]}
      ]
    }
  ]
}
